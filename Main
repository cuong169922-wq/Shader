btnHigh.AutoButtonColor = true

-- ==================== BIẾN TRẠNG THÁI ====================
local activeQuality = nil  -- "low", "medium", "high" hoặc nil (tắt)
local shaderEnabled = false
local originalSaved = false
local originalLighting = {}
local originalSky = nil
local originalClouds = nil
local effects = {}        -- chứa các effect, sky, clouds mới tạo
local timeLoopRunning = false
local timeMultiplier = 24 / 720  -- 24 giờ / 720 giây = 12 phút 1 ngày

-- ==================== HÀM LƯU & KHÔI PHỤC ====================
local function saveOriginalLighting()
    originalLighting = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        FogColor = Lighting.FogColor,
        FogStart = Lighting.FogStart,
        FogEnd = Lighting.FogEnd,
        GlobalShadows = Lighting.GlobalShadows,
        ShadowSoftness = Lighting.ShadowSoftness,
        ExposureCompensation = Lighting.ExposureCompensation,
        ColorShift_Top = Lighting.ColorShift_Top,
        ColorShift_Bottom = Lighting.ColorShift_Bottom,
        GeographicLatitude = Lighting.GeographicLatitude,
        TimeOfDay = Lighting.TimeOfDay,
    }
    
    -- Lưu Sky và Clouds gốc (nếu có)
    originalSky = Lighting:FindFirstChildOfClass("Sky")
    originalClouds = Lighting:FindFirstChildOfClass("Clouds")
    
    -- Tạm thời gỡ chúng khỏi Lighting để không xung đột
    if originalSky then
        originalSky.Parent = nil
    end
    if originalClouds then
        originalClouds.Parent = nil
    end
    
    originalSaved = true
end

local function clearEffects()
    for _, effect in ipairs(effects) do
        if effect and effect.Parent then
            effect:Destroy()
        end
    end
    effects = {}
end

local function revertOriginal()
    clearEffects()
    timeLoopRunning = false
    shaderEnabled = false
    
    if originalSaved then
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
        Lighting.FogColor = originalLighting.FogColor
        Lighting.FogStart = originalLighting.FogStart
        Lighting.FogEnd = originalLighting.FogEnd
        Lighting.GlobalShadows = originalLighting.GlobalShadows
        Lighting.ShadowSoftness = originalLighting.ShadowSoftness
        Lighting.ExposureCompensation = originalLighting.ExposureCompensation
        Lighting.ColorShift_Top = originalLighting.ColorShift_Top
        Lighting.ColorShift_Bottom = originalLighting.ColorShift_Bottom
        Lighting.GeographicLatitude = originalLighting.GeographicLatitude
        Lighting.TimeOfDay = originalLighting.TimeOfDay
        
        -- Trả lại Sky và Clouds gốc
        if originalSky then
            originalSky.Parent = Lighting
        end
        if originalClouds then
            originalClouds.Parent = Lighting
        end
    end
end

-- ==================== HÀM CẬP NHẬT MÔI TRƯỜNG THEO THỜI GIAN ====================
local function lerpColor(c1, c2, t)
    return Color3.new(
        c1.R + (c2.R - c1.R) * t,
        c1.G + (c2.G - c1.G) * t,
        c1.B + (c2.B - c1.B) * t
    )
end

local function updateEnvironment(time)
    -- time: 0 - 24 giờ
    local hour = time % 24
    
    -- Xác định phase: bình minh, ngày, hoàng hôn, đêm
    local morningStart, morningEnd = 5, 8
    local dayStart, dayEnd = 8, 17
    local duskStart, duskEnd = 17, 20
    
    local ambient, outdoorAmbient, fogColor, colorTop, colorBottom, exposure, bloomIntensity, sunRaysIntensity, cloudDensity, cloudCover
    
    if hour >= morningStart and hour < morningEnd then
        -- BÌNH MINH: vàng dịu pha xanh lá, không quá cam
        local t = (hour - morningStart) / (morningEnd - morningStart)
        ambient = lerpColor(Color3.fromRGB(80, 100, 110), Color3.fromRGB(150, 170, 130), t)
        outdoorAmbient = lerpColor(Color3.fromRGB(70, 90, 100), Color3.fromRGB(140, 160, 120), t)
        fogColor = lerpColor(Color3.fromRGB(180, 200, 210), Color3.fromRGB(220, 240, 210), t)
        colorTop = lerpColor(Color3.fromRGB(200, 210, 180), Color3.fromRGB(240, 250, 200), t)  -- vàng xanh nhạt
        colorBottom = lerpColor(Color3.fromRGB(60, 80, 110), Color3.fromRGB(110, 130, 100), t)
        exposure = 0.3
        bloomIntensity = 0.4
        sunRaysIntensity = 0.3
        cloudDensity = 0.4
        cloudCover = 0.5
    elseif hour >= morningEnd and hour < dayStart then
        -- TRƯA: trung tính, sáng rõ
        local t = (hour - morningEnd) / (dayStart - morningEnd)
        ambient = lerpColor(Color3.fromRGB(150, 170, 130), Color3.fromRGB(160, 180, 190), t)
        outdoorAmbient = lerpColor(Color3.fromRGB(140, 160, 120), Color3.fromRGB(150, 170, 180), t)
        fogColor = lerpColor(Color3.fromRGB(220, 240, 210), Color3.fromRGB(200, 220, 240), t)
        colorTop = lerpColor(Color3.fromRGB(240, 250, 200), Color3.fromRGB(200, 210, 240), t)
        colorBottom = lerpColor(Color3.fromRGB(110, 130, 100), Color3.fromRGB(120, 140, 160), t)
        exposure = 0.2
        bloomIntensity = 0.3
        sunRaysIntensity = 0.1
        cloudDensity = 0.5
        cloudCover = 0.6
    elseif hour >= dayStart and hour < duskStart then
        -- HOÀNG HÔN: cam nhẹ, ấm áp
        local t = (hour - dayStart) / (duskStart - dayStart)
        ambient = lerpColor(Color3.fromRGB(160, 180, 190), Color3.fromRGB(200, 150, 110), t)
        outdoorAmbient = lerpColor(Color3.fromRGB(150, 170, 180), Color3.fromRGB(190, 140, 100), t)
        fogColor = lerpColor(Color3.fromRGB(200, 220, 240), Color3.fromRGB(240, 200, 160), t)
        colorTop = lerpColor(Color3.fromRGB(200, 210, 240), Color3.fromRGB(255, 180, 120), t)
        colorBottom = lerpColor(Color3.fromRGB(120, 140, 160), Color3.fromRGB(120, 90, 60), t)
        exposure = 0.15
        bloomIntensity = 0.5
        sunRaysIntensity = 0.4
        cloudDensity = 0.6
        cloudCover = 0.7
    else
        -- ĐÊM: xanh đậm, tối, yên bình
        local t
        if hour >= duskStart and hour < 24 then
            t = (hour - duskStart) / (24 - duskStart)
        else
            t = (hour + (24 - duskStart)) / (24 - duskStart + morningStart)  -- từ 20h đến 5h sáng
        end
        ambient = lerpColor(Color3.fromRGB(200, 150, 110), Color3.fromRGB(30, 40, 80), t)
        outdoorAmbient = lerpColor(Color3.fromRGB(190, 140, 100), Color3.fromRGB(20, 30, 70), t)
        fogColor = lerpColor(Color3.fromRGB(240, 200, 160), Color3.fromRGB(40, 50, 90), t)
        colorTop = lerpColor(Color3.fromRGB(255, 180, 120), Color3.fromRGB(30, 40, 100), t)
        colorBottom = lerpColor(Color3.fromRGB(120, 90, 60), Color3.fromRGB(20, 20, 40), t)
        exposure = 0.0
        bloomIntensity = 0.2
        sunRaysIntensity = 0.0
        cloudDensity = 0.4
        cloudCover = 0.4
    end
    
    -- Áp dụng vào Lighting
    Lighting.Ambient = ambient
    Lighting.OutdoorAmbient = outdoorAmbient
    Lighting.FogColor = fogColor
    Lighting.ColorShift_Top = colorTop
    Lighting.ColorShift_Bottom = colorBottom
    Lighting.ExposureCompensation = exposure
    
    -- Cập nhật effect intensities (nếu tồn tại)
    for _, effect in ipairs(effects) do
        if effect:IsA("BloomEffect") then
            effect.Intensity = bloomIntensity
        elseif effect:IsA("SunRaysEffect") then
            effect.Intensity = sunRaysIntensity
        elseif effect:IsA("Clouds") then
            effect.Density = cloudDensity
            effect.Cover = cloudCover
        elseif effect:IsA("Atmosphere") then
            effect.Density = 0.2 + cloudDensity * 0.2
        end
    end
    
    -- Cập nhật hướng mặt trời
    local sunAngle = (hour - 6) / 12 * math.pi  -- 6h mọc, 18h lặn
    local sunDirection = Vector3.new(math.cos(sunAngle), math.sin(sunAngle), 0).Unit
    if sunDirection.Y < 0 then sunDirection = Vector3.new(0, -0.1, 0) end  -- ban đêm
    for _, effect in ipairs(effects) do
        if effect:IsA("Sky") then
            effect.SunDirection = sunDirection
        end
    end
end

-- ==================== HÀM BẬT SHADER ====================
local function applyCinematic(quality)
    clearEffects()
    if not originalSaved then
        saveOriginalLighting()
    end
    
    -- Tạo Sky điện ảnh
    local sky = Instance.new("Sky")
    sky.Name = "CinematicSky"
    sky.SunAngularSize = 8
    sky.MoonAngularSize = 6
    sky.SunTextureId = "rbxassetid://1234567890"  -- có thể thay bằng texture mặt trời đẹp
    sky.MoonTextureId = "rbxassetid://1234567891"
    sky.Parent = Lighting
    table.insert(effects, sky)
    
    -- Tạo mây (nếu được hỗ trợ)
    pcall(function()
        local clouds = Instance.new("Clouds")
        clouds.Name = "CinematicClouds"
        clouds.Density = 0.5
        clouds.Cover = 0.6
        clouds.Color = Color3.fromRGB(255, 255, 255)
        clouds.Parent = Lighting
        table.insert(effects, clouds)
    end)
    
    -- Color Correction
    local colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Name = "CinematicColorCorrection"
    colorCorrection.Saturation = 0.85
    colorCorrection.Contrast = 0.2
    colorCorrection.Brightness = 0.0
    colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)
    colorCorrection.Parent = Lighting
    table.insert(effects, colorCorrection)
    
    -- Bloom
    local bloom = Instance.new("BloomEffect")
    bloom.Name = "CinematicBloom"
    bloom.Intensity = 0.3
    bloom.Size = 40
    bloom.Threshold = 0.7
    bloom.Parent = Lighting
    table.insert(effects, bloom)
    
    -- Sun Rays
    local sunRays = Instance.new("SunRaysEffect")
    sunRays.Name = "CinematicSunRays"
    sunRays.Intensity = 0.2
    sunRays.Spread = 0.8
    sunRays.Parent = Lighting
    table.insert(effects, sunRays)
    
    -- Depth of Field (chỉ High)
    local depthOfField = Instance.new("DepthOfFieldEffect")
    depthOfField.Name = "CinematicDepthOfField"
    depthOfField.Enabled = (quality == "high")
    depthOfField.NearIntensity = 0.1
    depthOfField.FarIntensity = 0.3
    depthOfField.FocusDistance = 50
    depthOfField.InFocusRadius = 20
    depthOfField.Parent = Lighting
    table.insert(effects, depthOfField)
    
    -- Atmosphere
    local atmosphere = Instance.new("Atmosphere")
    atmosphere.Name = "CinematicAtmosphere"
    atmosphere.Density = 0.25
    atmosphere.Offset = 0.2
    atmosphere.Color = Color3.fromRGB(200, 210, 230)
    atmosphere.Decay = Color3.fromRGB(255, 220, 180)
    atmosphere.Glare = 0.1
    atmosphere.Haze = 1
    atmosphere.Parent = Lighting
    table.insert(effects, atmosphere)
    
    -- Bật bóng đổ mềm
    Lighting.GlobalShadows = true
    Lighting.ShadowSoftness = 0.3
    Lighting.GeographicLatitude = 35
    
    -- Khởi động vòng lặp thời gian
    shaderEnabled = true
    timeLoopRunning = true
    local lastTick = os.clock()
    
    spawn(function()
        while timeLoopRunning do
            local now = os.clock()
            local delta = now - lastTick
            lastTick = now
            Lighting.ClockTime = (Lighting.ClockTime + delta * timeMultiplier) % 24
            updateEnvironment(Lighting.ClockTime)
            wait(0.1)  -- cập nhật 10 lần/giây để mượt
        end
    end)
end

-- ==================== XỬ LÝ NÚT ====================
local function onQualityClick(quality)
    if activeQuality == quality then
        -- Tắt shader
        revertOriginal()
        activeQuality = nil
    else
        -- Bật shader với chất lượng mới
        if not originalSaved then
            saveOriginalLighting()
        end
        applyCinematic(quality)
        activeQuality = quality
    end
    updateButtons()
end

function updateButtons()
    btnLow.BackgroundColor3 = (activeQuality == "low") and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(45, 45, 45)
    btnMedium.BackgroundColor3 = (activeQuality == "medium") and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(45, 45, 45)
    btnHigh.BackgroundColor3 = (activeQuality == "high") and Color3.fromRGB(70, 130, 70) or Color3.fromRGB(45, 45, 45)
end

btnLow.MouseButton1Click:Connect(function() onQualityClick("low") end)
btnMedium.MouseButton1Click:Connect(function() onQualityClick("medium") end)
btnHigh.MouseButton1Click:Connect(function() onQualityClick("high") end)

-- ==================== DI CHUYỂN MENU ====================
local dragStartPos = nil
local frameStartPos = nil
local dragging = false

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
        frameStartPos = MainFrame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartPos
        MainFrame.Position = UDim2.new(frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X, frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- ==================== PHÓNG TO / THU NHỎ ====================
local resizeStartPos = nil
local frameStartSize = nil
local resizing = false

ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        resizing = true
        resizeStartPos = Vector2.new(input.Position.X, input.Position.Y)
        frameStartSize = MainFrame.Size
    end
end)

UIS.InputChanged:Connect(function(input)
    if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = Vector2.new(input.Position.X, input.Position.Y) - resizeStartPos
        local newWidth = math.max(180, frameStartSize.X.Offset + delta.X)
        local newHeight = math.max(120, frameStartSize.Y.Offset + delta.Y)
        MainFrame.Size = UDim2.new(0, newWidth, 0, newHeight)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        resizing = false
    end
end)

-- ==================== ĐÓNG MENU ====================
CloseButton.MouseButton1Click:Connect(function()
    revertOriginal()
    ScreenGui:Destroy()
end)

print("Shader menu 'meo bị down' đã sẵn sàng! 12 phút = 1 ngày, mây điện ảnh, ngày & đêm tự nhiên.")
